@{
    ViewData["Title"] = "NotFound";
}

<div class="section" style="padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-10 col-md-offset-1">
                <div class="panel" style="border:1px solid #E4E7ED; border-radius:8px; overflow:hidden; box-shadow:0 10px 30px rgba(46,54,69,.08);">
                    <div style="background:#1E1F29; color:#fff; padding:24px 30px; border-bottom:3px solid #D10024;">
                        <span style="display:inline-block; font-size:14px; font-weight:700; letter-spacing:1px; text-transform:uppercase; opacity:.85;">HemaBazaar</span>
                        <h1 style="margin:8px 0 0; font-size:36px; font-weight:700; line-height:1.1;">404 - Page Not Found</h1>
                    </div>

                    <div style="padding:40px 30px 34px; text-align:center;">
                        <div style="font-size:88px; font-weight:700; color:#D10024; line-height:1; margin-bottom:12px;">404</div>
                        <p style="font-size:16px; color:#2B2D42; margin-bottom:24px;">
                            Sorry, the page you are looking for does not exist, was moved, or is temporarily unavailable.
                        </p>

                        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
                            <a asp-controller="Home" asp-action="Index" class="primary-btn" style="padding:12px 22px;">
                                <i class="fa fa-home"></i> Go to Homepage
                            </a>
                            <a asp-controller="Item" asp-action="Index" class="primary-btn" style="padding:12px 22px; background:#15161D;">
                                <i class="fa fa-shopping-bag"></i> Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
