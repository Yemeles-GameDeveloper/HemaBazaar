@model IEnumerable<CartDTO>
@{
    ViewData["Title"] = "Cart";
    // Layout'u _ViewStart.cshtml'de ayarladıysan burada tekrar yazmana gerek yok.
    // Yoksa:
    // Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .order-total-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 20px; /* büyük */
        font-weight: 400;
        color: #D10024;
        margin-top: 20px;
        border-top: 2px solid #eee;
        padding-top: 15px;
    }

    .order-total-amount {
        font-size: 20px; /* rakamı daha da büyük */
    }

    .order-col {
        display: flex;
        justify-content: space-between;
    }

        .order-col div:last-child {
            text-align: right;
        }
</style>

<div class="section">
    <div class="container">
        <div class="row">

            <!-- CART ITEMS -->
            <div class="col-md-8">
                <div class="section-title">
                    <h3 class="title">Your Cart</h3>
                </div>

                <div class="cart-list">

                    
                    @foreach (var cart in Model)
                    {
                        <!-- Cart Item 1 -->
                        <div class="product-widget">
                            <div class="product-img">
                                @* <img src="~/img/product01.png" alt="Steel Longsword"> *@
                            </div>
                            <div class="product-body">
                                <p class="product-category">@cart.CategoryName</p>
                                <h3 class="product-name">
                                    <a href="#">@cart.Title</a>
                                </h3>
                                <h4 class="product-price">
                                    $@cart.Price
                                    <small class="qty">x @cart.Quantity</small>
                                </h4>

                                <!-- REMOVE BUTTON -->
                                <form asp-action="RemoveCart" asp-controller="Cart" method="post" style="margin-top:10px;">
                                 <input type="hidden" name="cartId" value="@cart.Id" />
                                    <button type="button" class="btn btn-danger btn-sm removeCart" data-id="@cart.Id">
                                 <i class="fa fa-trash"></i> Remove
                                </button>
                                </form>
                            </div>
                            @* <div class="cart-controls">
                                <input type="number" class="input" value="" min="1" style="width:70px;">
                                <button class="delete"><i class="fa fa-close"></i></button>
                            </div> *@
                        </div>
                        <!-- /Cart Item 1 -->
                    }

                </div>
            </div>
            <!-- /CART ITEMS -->
            <!-- CART SUMMARY -->
            @if (Model.Any())
            {
                <div class="col-md-4">
                    <div class="order-details">
                        <div class="section-title text-center">
                            <h3 class="title">Order Summary</h3>
                        </div>

                        <div class="order-summary">
                            <div class="order-col">
                                <div><strong>PRODUCT</strong></div>
                                <div><strong>SUBTOTAL</strong></div>
                            </div>

                            <div class="order-products">
                                @foreach (var cart in Model)
                                {
                                    <div class="order-col">
                                        <div>@cart.Title <span style="opacity:.7;">x @cart.Quantity</span></div>
                                        <div>$@(cart.Price* cart.Quantity)</div>
                                    </div>
                                }
                            </div>

                            <div class="order-col">
                                <div>Shipping</div>
                                <div><strong>FREE</strong></div>
                            </div>

                            <div class="order-col">
                                <div><strong>TOTAL</strong></div>
                                <div><strong>$@Model.Sum(x => x.Price * x.Quantity)</strong></div>
                            </div>

                            <a asp-controller="Payment" asp-action="Pay" class="primary-btn order-submit">Proceed to Checkout</a>
                            <a asp-controller="Home" asp-action="Index" class="primary-btn" style="margin-top:10px; background:#fff; color:#D10024; border:1px solid #D10024;">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-12">
                    <div class="empty-cart text-center" style="padding:40px 0;">
                        <h3>Your cart is empty 🛒</h3>
                        <p style="opacity:.7; margin-top:10px;">
                            Looks like you haven’t added anything to your cart yet.
                        </p>

                        <a href="/" class="primary-btn" style="margin-top:20px;">
                            Continue Shopping
                        </a>
                    </div>
                </div>
            }
            <!-- /CART SUMMARY -->

        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).on("click",".removeCart",function(){
             const $button = $(this);
             const cid = $button.data("id");
             const $cartItem = $button.closest(".product-widget");
            

            $.ajax({
                url:"/Cart/RemoveCart",
                type:"POST",
                data:{cartid: cid},
                success: function(res){
                         $cartItem.remove();
                    Swal.fire({
                        position: "top-center",
                        icon: "success",
                        title: res,
                        showConfirmButton: false,
                        timer: 1000
                    });

                    setTimeout(()=>{
                            location.reload();
                    },1000)
                },
                error: function(er){
                    const message = er?.responseText || "Item could not be added to cart.";
                    Swal.fire({
                        position: "top-center",
                        icon: "error",
                        title: message,
                        showConfirmButton: false,
                        timer: 2000
                    });
                }
            });
        });
    </script>
    }



   

