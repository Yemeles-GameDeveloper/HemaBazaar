@model IEnumerable<CategoryDTO>

<div class="col-md-6">
    <div class="header-search">
        <form style="display:flex; align-items:center; flex-wrap:nowrap;">
            <select class="input-select" style="width:240px; min-width:240px; border-radius:40px 0 0 40px; border-right:1px solid #E4E7ED;">
                <option value="">All Categories</option>
                @foreach (var category in (Model ?? Enumerable.Empty<CategoryDTO>()))
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            </select>
            <input class="input" placeholder="Search here" style="flex:1; min-width:0;">
            <button class="search-btn" type="submit" style="position:static;">Search</button>
        </form>
    </div>
</div>


