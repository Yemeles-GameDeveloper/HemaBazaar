@model CheckoutViewModel



<div class="section">
    <div class="container">
        <div class="row">


            <div class="col-md-8">
                <div class="billing-details">
                    <div class="section-title">
                        <h3 class="title">Billing details</h3>
                    </div>
                    <input type="hidden" asp-for="Price" value="@Model.Price" />
                    <input type="hidden" asp-for="PaidPrice" value="@Model.PaidPrice" />
                    <form id="checkoutForm" asp-controller="Payment" asp-action="Pay" method="post" class="checkout-form" novalidate>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input class="input" type="text" asp-for="Firstname" placeholder="First Name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input class="input" type="text" asp-for="Lastname" placeholder="Last Name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input class="input" type="email" asp-for="Email" placeholder="Email" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input class="input" type="tel" asp-for="PhoneNumber" placeholder="Phone" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <input class="input" type="text" asp-for="Address" placeholder="Adress 1" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input class="input" type="text" asp-for="City" placeholder="Adress 2" required>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <input class="input" type="text" asp-for="Country" placeholder="Country" required>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <input class="input" type="text" asp-for="ZIP" placeholder="ZIP / Postal" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <textarea class="input" asp-for="DeliveryInstructions" rows="3" placeholder="Delivery instructions (optional)"></textarea>
                                </div>
                            </div>
                        </div>


                       


                        <div class="section-title" style="margin-top:20px;">
                            <h3 class="title">Payment</h3>
                        </div>

                        <div class="payment-method" style="margin-bottom:15px;">
                            <div class="input-radio">
                                <input type="radio" name="payment" id="payment-1" checked>
                                <label for="payment-1">
                                    <span></span>
                                    Credit / Debit Card
                                </label>
                                <div class="caption">
                                    <p>Securely pay with your card and save the details for faster checkout next time.</p>
                                </div>
                            </div>
                            <div class="input-radio">
                                <input type="radio" name="payment" id="payment-2">
                                <label for="payment-2">
                                    <span></span>
                                    Cash on Delivery
                                </label>
                                <div class="caption">
                                    <p>Pay with cash or card when your order arrives at your doorstep.</p>
                                </div>
                            </div>
                        </div>

                        <div class="card-details" style="background:#f7f7f7; padding:15px; border:1px solid #e4e7ed; border-radius:4px;">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Card number</label>
                                        <input class="input" type="text" name="card-number" placeholder="1234 5678 9012 3456">
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label>Cardholder name</label>
                                        <input class="input" type="text" name="card-name" placeholder="Name on card">
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-6">
                                    <div class="form-group">
                                        <label>Exp.</label>
                                        <input class="input" type="text" name="card-exp" placeholder="MM/YY">
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-6">
                                    <div class="form-group">
                                        <label>CVC</label>
                                        <input class="input" type="text" name="card-cvc" placeholder="123">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            @Html.Raw(ViewBag.CheckoutFormContent)
            <div class="col-md-4">
                <div class="order-details">
                    <div class="section-title text-center">
                        <h3 class="title">Order Summary</h3>
                        <p style="margin-top:5px; opacity:.8;">Review your items before placing the order.</p>
                    </div>

                    <div class="order-summary">
                        <div class="order-col">
                            <div><strong>PRODUCT</strong></div>
                            <div><strong>SUBTOTAL</strong></div>
                        </div>

                        <div class="order-products">
                            @foreach (var cart in Model.CartItems)
                            {
                                <div class="order-col">
                                    <div>
                                        @cart.Title
                                        <span style="display:block; font-size:12px; opacity:.7;">@cart.CategoryName • Qty @cart.Quantity</span>
                                    </div>
                                    <div>$@((cart.Price * cart.Quantity).ToString("0.00"))</div>
                                </div>
                            }
                        </div>

                        <div class="order-col">
                            <div>Shipping</div>
                            <div><strong>FREE</strong></div>
                        </div>
                        <div class="order-col">
                            <div><strong>TOTAL</strong></div>
                            <div><strong>$@Model.PaidPrice.ToString("0.00")</strong></div>
                        </div>
                    </div>

                    <button type="submit" form="checkoutForm" class="primary-btn order-submit" style="width:100%; margin-top:10px;">Confirm Order</button>
                    <p style="font-size:12px; text-align:center; margin-top:10px; opacity:.8;">By placing your order you agree to our Terms &amp; Conditions.</p>
                </div>
            </div>
            
        </div>
    </div>
</div>