@model IEnumerable<CartDTO>
@{
    ViewData["Title"] = "Cart";
    // Layout'u _ViewStart.cshtml'de ayarladıysan burada tekrar yazmana gerek yok.
    // Yoksa:
    // Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .order-total-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 20px; /* büyük */
        font-weight: 400;
        color: #D10024;
        margin-top: 20px;
        border-top: 2px solid #eee;
        padding-top: 15px;
    }

    .order-total-amount {
        font-size: 20px; /* rakamı daha da büyük */
    }

    .order-col {
        display: flex;
        justify-content: space-between;
    }

        .order-col div:last-child {
            text-align: right;
        }
</style>

<div class="section">
    <div class="container">
        <div class="row">

            <!-- CART ITEMS -->
            <div class="col-md-8">
                <div class="section-title">
                    <h3 class="title">Your Cart</h3>
                </div>

                <div class="cart-list">

                    
                    @foreach (var cart in Model)
                    {
                        <!-- Cart Item 1 -->
                        <div class="product-widget">
                            <div class="product-img">
                                @* <img src="~/img/product01.png" alt="Steel Longsword"> *@
                            </div>
                            <div class="product-body">
                                <p class="product-category">@cart.CategoryName</p>
                                <h3 class="product-name">
                                    <a href="#">@cart.Title</a>
                                </h3>
                                <h4 class="product-price">
                                    $@cart.Price
                                    <small class="qty">x @cart.Quantity</small>
                                </h4>

                                <!-- REMOVE BUTTON -->
                                <form asp-action="RemoveCart" asp-controller="Cart" method="post" style="margin-top:10px;">
                                 <input type="hidden" name="cartId" value="@cart.Id" />
                                    <button type="button" class="btn btn-danger btn-sm" href=".removeCart" data.id="@cart.Id">
                                 <i class="fa fa-trash"></i> Remove
                                </button>
                                </form>
                            </div>
                            @* <div class="cart-controls">
                                <input type="number" class="input" value="" min="1" style="width:70px;">
                                <button class="delete"><i class="fa fa-close"></i></button>
                            </div> *@
                        </div>
                        <!-- /Cart Item 1 -->
                    }

                </div>
            </div>
            <!-- /CART ITEMS -->
            <!-- CART SUMMARY -->
            <div class="col-md-4">
                <div class="order-details">
                    <div class="section-title text-center">
                        <h3 class="title">Order Summary</h3>
                    </div>

                    <div class="order-summary">
                        <div class="order-col">
                            <div><strong>PRODUCT</strong></div>
                            <div><strong>SUBTOTAL</strong></div>
                        </div>

                        
                            @foreach(var cart in Model)
                        {
                            <div class="order-products">
                                <div class="order-col">
                                    <div>x @cart.Quantity</div>
                                    <div>@cart.Title</div>                                  
                                    <div>$@cart.Price</div>

                                </div>
                                <div class="order-col">
                                    <div>Shipping</div>
                                    <div><strong>FREE</strong></div>
                                </div>

                                <div class="order-col">
                                    <div><strong>TOTAL</strong></div>
                                    <div><strong>$@(cart.Price * cart.Quantity)</strong></div>
                                </div>
                            </div>
                        }
                        <div class="order-total-wrapper">
                            TOTAL PRICE:
                            <span class="order-total-amount">
                                $@Model.Sum(x => x.TotalPrice)
                            </span>
                        </div>

                        

                    <a href="/Checkout" class="primary-btn order-submit">Proceed to Checkout</a>
                    <a href="/" class="primary-btn" style="margin-top:10px; background:#fff; color:#D10024; border:1px solid #D10024;">
                        Continue Shopping
                    </a>
                </div>
            </div>
            <!-- /CART SUMMARY -->

        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).on("click",".removeCart",function(){
         const cid = $(this).data("id");
            

            $.ajax({
                url:"/Cart/RemoveCart",
                type:"POST",
                data:{cartid: cid},
                success: function(res){
                    Swal.fire({
                        position: "top-center",
                        icon: "success",
                        title: res,
                        showConfirmButton: false,
                        timer: 1500
                    });
                },
                error: function(er){
                    const message = er?.responseText || "Item could not be added to cart.";
                    Swal.fire({
                        position: "top-center",
                        icon: "error",
                        title: message,
                        showConfirmButton: false,
                        timer: 2000
                    });
                }
            });
        });
    </script>
    }

