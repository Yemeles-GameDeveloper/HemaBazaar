﻿@{
ViewData["Title"] = "Purchases";
}
@model IEnumerable<PurchaseDTO>

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="section-title">
                    <h3 class="title">Purchases</h3>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="panel panel-default" style="margin-bottom: 30px;">
                    <div class="panel-heading">
                        <h4 class="panel-title">Recent Orders</h4>
                    </div>
                    <div class="panel-body" style="padding: 0;">
                        <div class="table-responsive">
                            <table class="table table-striped" style="margin-bottom: 0;">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>UserName</th>
                                        <th>Date</th>
                                        <th>Products</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model )
                                    {
                                        <tr>
                                            <td>@item.TransactionId</td>
                                            <td>@item.UserName</td>
                                            <td>@item.PurchaseDate.ToString("MMM dd, yyyy")</td>
                                            <td>@item.ItemTitle</td>
                                            <td>@item.Amount</td>
                                            <td>@item.Status</td>
                                            
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Order Timeline</h4>
                    </div>
                    <div class="panel-body">
                        <ul class="list-unstyled" style="margin-bottom: 0;">
                            @foreach(var item in Model.OrderByDescending(x => x.PurchaseDate).Take(3))
                            {
                                <li style="margin-bottom: 12px;">
                                    <strong>@item.PurchaseDate.ToString("MMM dd")</strong> — #@item.TransactionId delivered to 1734 Stonecoal Road.
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="panel panel-default" style="margin-bottom: 30px;">
                    <div class="panel-heading">
                        <h4 class="panel-title">Purchase Summary</h4>
                    </div>
                    <div class="panel-body">
                        <p><strong>Total Orders:</strong> @Model.Count()</p>
                        <p><strong>Lifetime Spend:</strong> $@Model.Sum(x => x.Amount).ToString("N2")</p>
                        <p><strong>Average Order:</strong> $@(Model.Any() ? (Model.Sum(x => x.Amount) / Model.Count()).ToString("N2") : "0.00")</p>
                        <a href="#" class="primary-btn" style="margin-top: 10px; display: inline-block;">Download Invoices</a>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Need Help?</h4>
                    </div>
                    <div class="panel-body">
                        <p>Questions about an order or a refund? Our support team is ready to help.</p>
                        <a href="#" class="primary-btn">Contact Support</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
